# autoware.repos に含まれず apt（ros-humble-*）で入るメッセージパッケージ。
# 定義パック作成時に fetch_sources.py --repos tools/extra_sources.repos で追加取得する。
# バージョンは Humble の apt パッケージと同じものを指定する。
repositories:
  extra/geographic_info:   # geographic_msgs（tier4_api_msgs/AwapiVehicleStatus が参照）
    type: git
    url: https://github.com/ros-geographic-info/geographic_info.git
    version: 1.0.6
  extra/ros_canopen:       # can_msgs（ros2_socketcan, g30esli_interface）
    type: git
    url: https://github.com/ros-industrial/ros_canopen.git
    version: dashing-devel
  extra/ublox:             # ublox_msgs（gnss_poser）
    type: git
    url: https://github.com/KumarRobotics/ublox.git
    version: 2.3.0
  extra/navigation_msgs:   # map_msgs
    type: git
    url: https://github.com/ros-planning/navigation_msgs.git
    version: humble
  extra/grid_map:          # grid_map_msgs
    type: git
    url: https://github.com/ANYbotics/grid_map.git
    version: humble
  extra/rosbridge_suite:   # rosbridge_msgs（web_controller が起動する rosbridge_server の /connected_clients など）
    type: git
    url: https://github.com/RobotWebTools/rosbridge_suite.git
    version: humble
  extra/pcl_msgs:          # pcl_msgs（pointcloud_preprocessor, occupancy_grid_map_outlier_filter）
    type: git
    url: https://github.com/ros-perception/pcl_msgs.git
    version: ros2
  extra/example_interfaces:  # example_interfaces（driving_log_replayer）
    type: git
    url: https://github.com/ros2/example_interfaces.git
    version: humble
